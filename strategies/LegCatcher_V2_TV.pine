// This Pine Script™ strategy is subject to the terms of the Mozilla Public License 2.0
// © emrehaskilic — Leg Catcher V2: Exhaustion Reversal
// Designed for 3-minute chart, crypto futures (BTCUSDT, ETHUSDT etc.)
//
// FARK: V1 leg'i kovalıyordu (geç giriş = tepeyi al, dibi sat)
// V2 leg'in BİTTİĞİNİ tespit edip TERS YÖNE giriyor.
//
// Mantık:
//   1. Bir yönde güçlü hareket olmuş (leg oluşmuş)
//   2. Momentum azalıyor (mumlar küçülüyor, hacim düşüyor)
//   3. İlk güçlü ters mum geldiğinde → yeni leg başlıyor → GİR

//@version=5
strategy("Leg Catcher V2 — Exhaustion Reversal", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.02, slippage=1, initial_capital=10000, currency=currency.USD, calc_on_every_tick=false)

// ══════════════════════════════════════════════════════════════
// INPUTS
// ══════════════════════════════════════════════════════════════

grp_exhaust = "── Exhaustion Detection ──"
legLen          = input.int(5, "Leg Lookback (candles)", minval=3, maxval=10, group=grp_exhaust, tooltip="Önceki leg'i ölçmek için kaç muma bak")
legMinCandles   = input.int(3, "Min Candles Same Dir in Leg", minval=2, maxval=7, group=grp_exhaust, tooltip="Leg sayılması için min aynı yönde mum")
shrinkRatio     = input.float(0.5, "Body Shrink Ratio", minval=0.2, maxval=0.8, step=0.1, group=grp_exhaust, tooltip="Son mumun gövdesi, leg ortalamasının bu katından küçükse yorgunluk")

grp_trigger = "── Reversal Trigger ──"
triggerBodyMult = input.float(1.2, "Trigger Candle Body (x avg)", minval=0.8, step=0.1, group=grp_trigger, tooltip="Tetikleyici ters mumun gövdesi, ortalamanın kaç katı olmalı")
triggerVolMult  = input.float(1.1, "Trigger Volume (x avg)", minval=0.8, step=0.1, group=grp_trigger, tooltip="Tetikleyici mumun hacmi, ortalamanın kaç katı")
volLen          = input.int(20, "Volume MA Length", minval=5, maxval=50, group=grp_trigger)

grp_exit    = "── Exit Rules ──"
atrLen          = input.int(14, "ATR Length", minval=5, maxval=50, group=grp_exit)
slAtrMult       = input.float(1.5, "Stop Loss (ATR x)", minval=0.5, step=0.1, group=grp_exit)
tpAtrMult       = input.float(2.5, "Take Profit (ATR x)", minval=1.0, step=0.1, group=grp_exit)
useTrailing     = input.bool(true, "Use Trailing Stop", group=grp_exit)
trailActivation = input.float(1.0, "Trail Activation (ATR x)", minval=0.5, step=0.1, group=grp_exit, tooltip="Trailing stop bu kadar karda aktifleşir")
trailOffset     = input.float(0.8, "Trail Offset (ATR x)", minval=0.3, step=0.1, group=grp_exit, tooltip="Trailing stop mesafesi")
maxBarsInTrade  = input.int(30, "Max Bars in Trade", minval=10, maxval=100, group=grp_exit, tooltip="Bu kadar bar sonra kapat (zaman stop)")

grp_filter  = "── Market Filter ──"
useAtrFilter    = input.bool(true, "ATR Filter (Range Market)", group=grp_filter)
atrFilterLen    = input.int(50, "ATR Filter MA Length", minval=20, maxval=100, group=grp_filter)
atrFilterMult   = input.float(0.7, "ATR Min Threshold (x avg)", minval=0.3, step=0.1, group=grp_filter)

grp_risk    = "── Risk Management ──"
dailyMaxLoss    = input.float(1.5, "Daily Max Loss %", minval=0.5, maxval=5.0, step=0.5, group=grp_risk)
maxTradesDay    = input.int(6, "Max Trades / Day", minval=1, maxval=20, group=grp_risk)
cooldownBars    = input.int(5, "Cooldown After Trade (bars)", minval=0, maxval=20, group=grp_risk, tooltip="Trade sonrası kaç bar bekle")

// ══════════════════════════════════════════════════════════════
// CORE CALCULATIONS
// ══════════════════════════════════════════════════════════════

atr = ta.atr(atrLen)
atrMA = ta.sma(atr, atrFilterLen)
volMA = ta.sma(volume, volLen)

// --- Candle body size ---
bodySize = math.abs(close - open)
avgBody = ta.sma(bodySize, legLen)

// --- Candle direction ---
isBull(idx) => close[idx] > open[idx]
isBear(idx) => close[idx] < open[idx]

// ══════════════════════════════════════════════════════════════
// STEP 1: DETECT PRIOR LEG (was there a directional move?)
// ══════════════════════════════════════════════════════════════

// Count bullish and bearish candles in the lookback window (excluding current candle)
var int prevBullCount = 0
var int prevBearCount = 0
prevBullCount := 0
prevBearCount := 0

for i = 1 to legLen
    if isBull(i)
        prevBullCount += 1
    if isBear(i)
        prevBearCount += 1

// A bullish leg existed = mostly bull candles in lookback
priorBullLeg = prevBullCount >= legMinCandles
priorBearLeg = prevBearCount >= legMinCandles

// ══════════════════════════════════════════════════════════════
// STEP 2: DETECT EXHAUSTION (is the leg losing steam?)
// ══════════════════════════════════════════════════════════════

// Average body size of the leg candles (previous N, excluding current)
var float legAvgBody = 0.0
legAvgBody := 0.0
int legBodyCount = 0
for i = 1 to legLen
    legAvgBody += math.abs(close[i] - open[i])
    legBodyCount += 1
legAvgBody := legBodyCount > 0 ? legAvgBody / legBodyCount : avgBody

// Last 1-2 candles before current are shrinking = exhaustion
lastCandleSmall = math.abs(close[1] - open[1]) < legAvgBody * shrinkRatio
secondLastSmall = math.abs(close[2] - open[2]) < legAvgBody * shrinkRatio
exhaustion = lastCandleSmall or secondLastSmall

// ══════════════════════════════════════════════════════════════
// STEP 3: REVERSAL TRIGGER (strong opposite candle NOW)
// ══════════════════════════════════════════════════════════════

// Current candle is strong and in OPPOSITE direction of the prior leg
currentBody = math.abs(close - open)
strongBody = currentBody >= avgBody * triggerBodyMult
highVolume = volume >= volMA * triggerVolMult

// Bullish reversal: prior leg was bearish, exhaustion, now strong bull candle
bullReversal = priorBearLeg and exhaustion and isBull(0) and strongBody and highVolume
// Bearish reversal: prior leg was bullish, exhaustion, now strong bear candle
bearReversal = priorBullLeg and exhaustion and isBear(0) and strongBody and highVolume

// ══════════════════════════════════════════════════════════════
// FILTERS
// ══════════════════════════════════════════════════════════════

// --- ATR filter ---
atrOk = useAtrFilter ? atr > atrMA * atrFilterMult : true

// --- Daily loss guard ---
var float dayStartEquity = strategy.equity
var int lastDay = dayofmonth
if dayofmonth != lastDay
    dayStartEquity := strategy.equity
    lastDay := dayofmonth

dayPnLPct = ((strategy.equity - dayStartEquity) / dayStartEquity) * 100
dailyLossOk = dayPnLPct > -dailyMaxLoss

// --- Daily trade counter ---
var int tradesToday = 0
if dayofmonth != lastDay[1]
    tradesToday := 0
tradeCountOk = tradesToday < maxTradesDay

// --- Cooldown after trade ---
var int barsSinceExit = 100
barsSinceExit += 1
cooldownOk = barsSinceExit >= cooldownBars

// --- Not already in position ---
flat = strategy.position_size == 0

// --- Combined filter ---
filtersOk = atrOk and dailyLossOk and tradeCountOk and cooldownOk and flat

// ══════════════════════════════════════════════════════════════
// ENTRY SIGNALS
// ══════════════════════════════════════════════════════════════

longEntry  = bullReversal and filtersOk
shortEntry = bearReversal and filtersOk

// ══════════════════════════════════════════════════════════════
// POSITION MANAGEMENT
// ══════════════════════════════════════════════════════════════

var float entryPrice = na
var int barsInTrade = 0

if longEntry or shortEntry
    entryPrice := close
    barsInTrade := 0
    tradesToday += 1

if strategy.position_size != 0
    barsInTrade += 1

// ══════════════════════════════════════════════════════════════
// EXECUTE ENTRIES
// ══════════════════════════════════════════════════════════════

if longEntry
    sl = close - atr * slAtrMult
    tp = close + atr * tpAtrMult
    strategy.entry("Long", strategy.long)
    strategy.exit("Exit L", "Long", stop=sl, limit=tp)

if shortEntry
    sl = close + atr * slAtrMult
    tp = close - atr * tpAtrMult
    strategy.entry("Short", strategy.short)
    strategy.exit("Exit S", "Short", stop=sl, limit=tp)

// ══════════════════════════════════════════════════════════════
// TRAILING STOP (activates after price moves in favor)
// ══════════════════════════════════════════════════════════════

if useTrailing and strategy.position_size > 0
    priceGain = high - entryPrice
    if priceGain >= atr * trailActivation
        trailPrice = high - atr * trailOffset
        strategy.exit("Trail L", "Long", stop=trailPrice)

if useTrailing and strategy.position_size < 0
    priceGain = entryPrice - low
    if priceGain >= atr * trailActivation
        trailPrice = low + atr * trailOffset
        strategy.exit("Trail S", "Short", stop=trailPrice)

// ══════════════════════════════════════════════════════════════
// TIME STOP (max bars in trade)
// ══════════════════════════════════════════════════════════════

if strategy.position_size != 0 and barsInTrade >= maxBarsInTrade
    strategy.close_all(comment="Time Stop")
    barsSinceExit := 0

// Reset cooldown on any exit
if strategy.position_size == 0 and strategy.position_size[1] != 0
    barsSinceExit := 0

// ══════════════════════════════════════════════════════════════
// PLOTS
// ══════════════════════════════════════════════════════════════

// --- Entry signals ---
plotshape(longEntry, "Long Entry", shape.triangleup, location.belowbar, color.new(#00E676, 0), size=size.normal, text="LEG")
plotshape(shortEntry, "Short Entry", shape.triangledown, location.abovebar, color.new(#FF1744, 0), size=size.normal, text="LEG")

// --- Exhaustion zones ---
plotshape(priorBullLeg and exhaustion and flat and not bearReversal, "Bull Exhaustion", shape.diamond, location.abovebar, color.new(color.yellow, 40), size=size.tiny)
plotshape(priorBearLeg and exhaustion and flat and not bullReversal, "Bear Exhaustion", shape.diamond, location.belowbar, color.new(color.yellow, 40), size=size.tiny)

// --- ATR filter background ---
bgcolor(useAtrFilter and not atrOk ? color.new(color.gray, 92) : na, title="Range Market")

// --- Daily loss lock ---
bgcolor(not dailyLossOk ? color.new(color.red, 92) : na, title="Daily Loss Lock")

// --- Cooldown period ---
bgcolor(not cooldownOk and flat ? color.new(color.blue, 95) : na, title="Cooldown")

// ══════════════════════════════════════════════════════════════
// INFO TABLE
// ══════════════════════════════════════════════════════════════

var table infoTable = table.new(position.top_right, 2, 9, bgcolor=color.new(color.black, 80), border_width=1)

if barstate.islast
    table.cell(infoTable, 0, 0, "LEG CATCHER V2", text_color=color.yellow, text_size=size.small)
    table.cell(infoTable, 1, 0, "Exhaustion Rev.", text_color=color.yellow, text_size=size.small)

    table.cell(infoTable, 0, 1, "ATR", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 1, str.tostring(atr, "#.##"), text_color=atrOk ? color.green : color.red, text_size=size.small)

    table.cell(infoTable, 0, 2, "Vol/Avg", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 2, str.tostring(volume / volMA, "#.##") + "x", text_color=highVolume ? color.green : color.gray, text_size=size.small)

    table.cell(infoTable, 0, 3, "Prior Bull Leg", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 3, priorBullLeg ? "YES (" + str.tostring(prevBullCount) + "/" + str.tostring(legLen) + ")" : "NO", text_color=priorBullLeg ? color.green : color.gray, text_size=size.small)

    table.cell(infoTable, 0, 4, "Prior Bear Leg", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 4, priorBearLeg ? "YES (" + str.tostring(prevBearCount) + "/" + str.tostring(legLen) + ")" : "NO", text_color=priorBearLeg ? color.red : color.gray, text_size=size.small)

    table.cell(infoTable, 0, 5, "Exhaustion", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 5, exhaustion ? "DETECTED" : "—", text_color=exhaustion ? color.yellow : color.gray, text_size=size.small)

    table.cell(infoTable, 0, 6, "Body/Avg", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 6, str.tostring(currentBody / avgBody, "#.##") + "x", text_color=strongBody ? color.green : color.gray, text_size=size.small)

    table.cell(infoTable, 0, 7, "Day PnL", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 7, str.tostring(dayPnLPct, "#.##") + "%", text_color=dayPnLPct >= 0 ? color.green : color.red, text_size=size.small)

    table.cell(infoTable, 0, 8, "Trades Today", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 8, str.tostring(tradesToday) + "/" + str.tostring(maxTradesDay), text_color=tradeCountOk ? color.green : color.orange, text_size=size.small)
